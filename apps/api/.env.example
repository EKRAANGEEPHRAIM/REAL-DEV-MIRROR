# Copier ce fichier en .env (jamais commité)
NODE_ENV=development
PORT=3000
# Origines autorisées par CORS, séparées par des virgules
CORS_ORIGIN=http://localhost:4200

# Neon (Dashboard > Connect) : URL poolée, l'hôte contient "-pooler".
# prisma.config.ts en déduit l'URL directe pour les migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Secret des jetons d'accès JWT, 32 caractères minimum. Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=remplacer-par-un-secret-aleatoire-de-48-octets
# Facultatifs : jeton d'accès 15 min, refresh token 7 jours
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=7
