{
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          },
          "503": {
            "description": "Base injoignable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseDto"
                }
              }
            }
          }
        },
        "summary": "État de l'API et de la base de données",
        "tags": ["health"]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "AuthController_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pose aussi le cookie dm_refresh",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Données invalides (nom, email ou mot de passe)"
          },
          "409": {
            "description": "Un compte existe déjà avec cet email"
          },
          "429": {
            "description": "Trop de tentatives, réessayez dans une minute"
          }
        },
        "summary": "Créer un compte et ouvrir une session",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pose aussi le cookie dm_refresh",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Données invalides"
          },
          "401": {
            "description": "Email ou mot de passe incorrect"
          },
          "429": {
            "description": "Trop de tentatives, réessayez dans une minute"
          }
        },
        "summary": "Se connecter",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Cookie absent, expiré, révoqué ou réutilisé"
          },
          "429": {
            "description": "Trop de tentatives, réessayez dans une minute"
          }
        },
        "security": [
          {
            "dm_refresh": []
          }
        ],
        "summary": "Renouveler la session à partir du cookie dm_refresh (rotation)",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "operationId": "AuthController_verifyEmail",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          },
          "400": {
            "description": "Lien invalide, expiré ou déjà utilisé"
          },
          "429": {
            "description": "Trop de tentatives, réessayez dans une minute"
          }
        },
        "summary": "Confirmer l’adresse email avec le jeton reçu par email",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/resend-verification": {
      "post": {
        "operationId": "AuthController_resendVerification",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Envoyé, ou rien à faire si l’adresse est déjà vérifiée"
          },
          "401": {
            "description": "Jeton d’accès manquant ou invalide"
          },
          "429": {
            "description": "Trop de tentatives, réessayez dans une minute"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Renvoyer l’email de vérification",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/forgot-password": {
      "post": {
        "operationId": "AuthController_forgotPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordDto"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Toujours renvoyé, que l’email soit inscrit ou non (pas d’énumération)"
          },
          "429": {
            "description": "Trop de tentatives, réessayez dans une minute"
          }
        },
        "summary": "Demander un lien de réinitialisation du mot de passe",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/reset-password": {
      "post": {
        "operationId": "AuthController_resetPassword",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordDto"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          },
          "400": {
            "description": "Lien invalide ou expiré, ou mot de passe trop faible"
          },
          "429": {
            "description": "Trop de tentatives, réessayez dans une minute"
          }
        },
        "summary": "Choisir un nouveau mot de passe ; ferme toutes les sessions",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          },
          "429": {
            "description": "Trop de tentatives, réessayez dans une minute"
          }
        },
        "security": [
          {
            "dm_refresh": []
          }
        ],
        "summary": "Fermer la session courante",
        "tags": ["auth"]
      }
    },
    "/api/v1/auth/logout-all": {
      "post": {
        "operationId": "AuthController_logoutAll",
        "parameters": [],
        "responses": {
          "204": {
            "description": ""
          },
          "401": {
            "description": "Jeton d’accès manquant ou invalide"
          },
          "429": {
            "description": "Trop de tentatives, réessayez dans une minute"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Fermer toutes les sessions de l’utilisateur",
        "tags": ["auth"]
      }
    },
    "/api/v1/users/me": {
      "get": {
        "operationId": "UsersController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Jeton d’accès manquant ou invalide"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Profil de l’utilisateur connecté",
        "tags": ["users"]
      }
    }
  },
  "info": {
    "title": "DevMirror API",
    "description": "API REST de DevMirror : projets, tâches, objectifs, notes et statistiques.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "dm_refresh"
      }
    },
    "schemas": {
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "degraded"],
            "example": "ok"
          },
          "database": {
            "type": "string",
            "enum": ["up", "down"],
            "example": "up",
            "description": "Connexion à Neon PostgreSQL"
          },
          "uptime": {
            "type": "number",
            "example": 42,
            "description": "Durée de fonctionnement de l'API, en secondes"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-10-14T12:00:00.000Z"
          }
        },
        "required": ["status", "database", "uptime", "timestamp"]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ada Lovelace",
            "minLength": 2,
            "maxLength": 80
          },
          "email": {
            "type": "string",
            "example": "ada@devmirror.dev"
          },
          "password": {
            "type": "string",
            "example": "MotDePasse2026",
            "minLength": 8,
            "maxLength": 72,
            "description": "Au moins 8 caractères, dont une lettre et un chiffre"
          }
        },
        "required": ["name", "email", "password"]
      },
      "UserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "clx1a2b3c0000qz8h4k9d7f2e"
          },
          "email": {
            "type": "string",
            "example": "ada@devmirror.dev"
          },
          "name": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "emailVerified": {
            "type": "boolean",
            "example": false
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-10-17T09:00:00.000Z"
          }
        },
        "required": ["id", "email", "name", "avatarUrl", "emailVerified", "createdAt"]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9…"
          },
          "tokenType": {
            "type": "string",
            "enum": ["Bearer"],
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "number",
            "example": 900,
            "description": "Durée de vie du jeton d'accès, en secondes"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponseDto"
          }
        },
        "required": ["accessToken", "tokenType", "expiresIn", "user"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@devmirror.dev"
          },
          "password": {
            "type": "string",
            "example": "MotDePasse2026"
          }
        },
        "required": ["email", "password"]
      },
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Jeton reçu dans le lien de l’email",
            "example": "q5Yw0bJt8vZr3mN1xKc7Ld2Pf9Hs4Ug6Ae0Wi3Ty5Ro"
          }
        },
        "required": ["token"]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "ada@devmirror.dev"
          }
        },
        "required": ["email"]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Jeton reçu dans le lien de l’email",
            "example": "q5Yw0bJt8vZr3mN1xKc7Ld2Pf9Hs4Ug6Ae0Wi3Ty5Ro"
          },
          "password": {
            "type": "string",
            "example": "MotDePasse2026",
            "minLength": 8,
            "maxLength": 72,
            "description": "Au moins 8 caractères, dont une lettre et un chiffre"
          }
        },
        "required": ["token", "password"]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Ressource introuvable",
            "description": "Message affichable ; liste de messages pour les erreurs de validation"
          },
          "error": {
            "type": "string",
            "example": "Not Found"
          },
          "path": {
            "type": "string",
            "example": "/api/v1/projects/clx1a2b3c"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-10-20T09:00:00.000Z"
          }
        },
        "required": ["statusCode", "message", "error", "path", "timestamp"]
      },
      "PaginationMetaDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "example": 42,
            "description": "Nombre total d’éléments correspondant aux filtres"
          },
          "page": {
            "type": "number",
            "example": 1
          },
          "limit": {
            "type": "number",
            "example": 20
          },
          "totalPages": {
            "type": "number",
            "example": 3
          }
        },
        "required": ["total", "page", "limit", "totalPages"]
      }
    }
  }
}
