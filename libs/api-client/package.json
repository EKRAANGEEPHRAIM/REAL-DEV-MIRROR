{
  "name": "@devmirror/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Types TypeScript de l'API DevMirror, générés depuis son OpenAPI",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json --output src/schema.d.ts --default-non-nullable false"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
